# Copy to config.yaml and edit. Every field can also be set through the
# environment variable named in the comment; the environment wins.

addr: 127.0.0.1:8080 # ADDR — keep it on localhost, the API is unauthenticated
data_dir: ./data # DATA_DIR — wallets.json and mnemonic.txt live here
open_browser: true # OPEN_BROWSER

# MNEMONIC — leave empty to generate one into {data_dir}/mnemonic.txt on first run.
mnemonic: ""
# PASSPHRASE — the BIP39 passphrase. Changing it after wallets exist changes
# every address and the service will refuse to start.
passphrase: ""

network: mainnet # NETWORK — mainnet or nile

# NODES — comma-separated, "scheme://host[:port][|tier]".
# Schemes: grpc, grpcs (TLS), http, https. Empty uses the network defaults.
# nodes: "grpcs://grpc.trongrid.io:50051,https://api.trongrid.io,https://tron-rpc.publicnode.com|1"
nodes: ""

api_key: "" # TRON_PRO_API_KEY — TronGrid key, optional but avoids rate limits
usdt_contract: "" # USDT_CONTRACT — empty uses the network default
fee_limit_trx: 50 # FEE_LIMIT_TRX — fee cap for TRC20 transfers
