# Persistent settings are stored as ~/.walletspace/config.yaml.
# Prefer editing them through http://127.0.0.1:8080/settings.
schema_version: 1

server:
  # Loopback only. A change is applied after restart.
  addr: 127.0.0.1:8080
  open_browser: true

security:
  # Go duration. Zero disables automatic locking.
  auto_lock: 15m0s

node_discovery:
  # Configure the service URL through /settings before enabling discovery.
  enabled: false
  url: ""
  refresh_interval: 30m0s
  request_timeout: 5s
  # HTTP and private-address RPC endpoints stay disabled by default.
  allow_insecure_rpc: false

ui:
  last_space_id: ""
